{
  admin off
  email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
  encode zstd gzip

  @health path /health/*
  handle @health {
    respond 404
  }

  handle_path /static/* {
    root * /srv/static
    file_server
  }

  handle {
    reverse_proxy web:8000
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "same-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    -Server
  }
}
